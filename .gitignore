# Secrets — nothing private is ever tracked; env vars only
*private*
.env
.env.*

# Run artifacts: manifests are tracked, bulk outputs are not
runs/*/artifacts/
runs/*/data/
*.sqlite
*.feather
*.parquet
*.fthypt

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Notebooks: executed outputs live in runs/, templates stay clean
notebooks/**/*.executed.ipynb
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# deploy runtime state
deploy/user_data/data/
deploy/user_data/backtest_results/
deploy/user_data/logs/
deploy/user_data/*.sqlite*
deploy/observer_data/
