# Copy to .env and fill in. .env is gitignored — keys are NEVER committed.
# Every entry point (factory CLI, tools/ runners) loads .env at startup via
# factory.env.load_env; a variable already exported in your shell wins.

# Anthropic — the S0-S4 LLM stages (Claude Agent SDK). Keys: https://console.anthropic.com
# Optional if this machine has a Claude Code login: the SDK falls back to it,
# and load_env skips blank values so this empty slot never shadows that.
ANTHROPIC_API_KEY=

# Nixtla TimeGPT — the §20.17 second alarm (factory timegpt). Signup: https://dashboard.nixtla.io
NIXTLA_API_KEY=

# TypeSafe Jev — the S0 kinship advisory (Plan §17 topic 2). Keys: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
